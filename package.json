{
  "name": "sheep-portal",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "start:local": "node scripts/run-local.mjs",
    "db:up": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d db",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "access": "tsx scripts/access.ts",
    "import:farmers": "tsx scripts/import-farmers.ts",
    "export": "tsx scripts/export.ts",
    "db:backfill-flags": "tsx scripts/backfill-flags.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "17.4.2",
    "leaflet": "1.9.4",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-leaflet": "5.0.0"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.22",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.2",
    "postcss": "8.5.32",
    "prisma": "7.10.1",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
