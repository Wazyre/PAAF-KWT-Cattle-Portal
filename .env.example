# Use 127.0.0.1 (not "localhost") so Node/Prisma don't resolve to IPv6 ::1,
# which the Postgres container does not listen on by default.
DATABASE_URL="postgresql://sheep:sheep@127.0.0.1:5432/sheep_portal?schema=public"

# --- Sign-in (PACI) ---
# "live" (default) sends real PACI push requests. "mock" approves automatically: for local testing ONLY, never on a real server.
# In mock mode a civil ID ending in 9 is refused and one ending in 8 never answers.
PACI_MODE="mock"
# PACI_AUTH_URL="https://kmidinteg.paaf.gov.kw/api/PACI/Auth"
# PACI_AUTH_HEADER="Authorization: Bearer <token>"   # only if PACI requires a credential header
# PACI_TIMEOUT_SECONDS=120                            # how long a person has to approve on their phone
# PACI_CALLBACK_SECRET=<long random text>             # if set, the callback URL registered with PACI must end in ?key=<this>
# SESSION_SECRET=<long random text>                   # optional; otherwise one is generated and kept in the database
