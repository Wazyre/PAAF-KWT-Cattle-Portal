generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Seeded national-ID lookup table. Swap for real Sahel/PACI SSO later
/// by replacing the lookup in src/lib/identity.ts only.
model Citizen {
  civilId String @id
  name    String
}

/// Runtime on/off switch per farmer-portal feature, managed with `npm run access`.
/// No row for a feature means it is open to everyone (ALL).
model FeatureAccess {
  feature   Feature    @id
  mode      AccessMode @default(ALL)
  /// Only consulted when mode = SPECIFIC.
  civilIds  String[]
  updatedAt DateTime   @updatedAt
}

enum Feature {
  REGISTRATION // first-time declarations
  UPDATES      // edits to an existing declaration
}

enum AccessMode {
  ALL      // open to every citizen
  OFF      // closed to everyone
  SPECIFIC // open only to the listed civil IDs
}

model Declaration {
  id        Int      @id @default(autoincrement())
  civilId   String   @unique
  name      String
  mobile    String
  mobile2   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// True when total declared heads (sum of chippedCount) < LOW_HEAD_THRESHOLD. Maintained on submit.
  lowHeadCount Boolean @default(false)

  animalGroups    AnimalGroup[]
  audit           Audit?
  revisions       DeclarationRevision[]
  soloAssignments Assignment[]          @relation("SoloAssignment")
}

model DeclarationRevision {
  id            Int      @id @default(autoincrement())
  declarationId Int
  revisedAt     DateTime @default(now())
  mobile        String
  locations     Json

  declaration Declaration @relation(fields: [declarationId], references: [id], onDelete: Cascade)

  @@index([declarationId])
}

model AnimalGroup {
  id            Int        @id @default(autoincrement())
  declarationId Int
  animalType    AnimalType

  declaration Declaration  @relation(fields: [declarationId], references: [id], onDelete: Cascade)
  locations   FarmLocation[]

  @@index([declarationId])
}

model FarmLocation {
  id             Int            @id @default(autoincrement())
  animalGroupId  Int
  gatheringPoint GatheringPoint
  latitude       Float
  longitude      Float
  locationLink   String
  chippedCount   Int
  males          Int
  females        Int
  numTenders     Int

  animalGroup AnimalGroup @relation(fields: [animalGroupId], references: [id], onDelete: Cascade)

  @@index([animalGroupId])
}

model Audit {
  id            Int      @id @default(autoincrement())
  declarationId Int      @unique
  createdAt     DateTime @default(now())

  /// Set by the head investigator; cleared whenever the audit is saved again.
  approvedAt    DateTime?

  /// Optional: why the field visit could not be completed. visitFailureNote is only used with OTHER.
  visitFailureReason VisitFailureReason?
  visitFailureNote   String?

  declaration   Declaration        @relation(fields: [declarationId], references: [id], onDelete: Cascade)
  animalResults AuditAnimalResult[]
}

enum VisitFailureReason {
  FARMER_NOT_FOUND   // farmer not found at the location
  LOCATION_NOT_READY // location was not ready for the field visit
  TEAM_STOPPED       // the audit team was stopped
  OTHER
}

model AuditAnimalResult {
  id                Int             @id @default(autoincrement())
  auditId           Int
  animalType        AnimalType
  siteIndex         Int             @default(0)
  violationStatus   ViolationStatus
  differenceReasons Json
  locationLink       String
  latitude           Float?
  longitude          Float?
  manualCount        Int?
  doesntBelongCount  Int?

  audit    Audit         @relation(fields: [auditId], references: [id], onDelete: Cascade)
  readings ChipReading[]

  @@unique([auditId, animalType, siteIndex])
  @@index([auditId])
}

model ChipReading {
  id                   Int      @id @default(autoincrement())
  animalResultId       Int
  readAt               DateTime
  chipNumber           String
  rawChip              String
  flaggedSymbol        Boolean  @default(false)
  flaggedProximity     Boolean  @default(false)
  flaggedMultipleChips Boolean  @default(false)
  flaggedDoesntBelong  Boolean  @default(false)

  animalResult AuditAnimalResult @relation(fields: [animalResultId], references: [id], onDelete: Cascade)

  @@index([animalResultId])
}

enum GatheringPoint {
  WAFRA
  JAHRA
  KABD
  ABDALI
  MINA_ABDULLAH
}

enum AnimalType {
  SHEEP_GOATS
  CAMELS
  COWS
}

enum ViolationStatus {
  NONE
  VIOLATION
}

enum GroupType {
  SMALL
  SOLO
}

model Supervisor {
  id          Int          @id @default(autoincrement())
  civilId     String       @unique
  name        String
  assignments Assignment[]
}

/// Head supervisors (رئيس المفتشين): may open the head-supervisor portal. Loaded ahead of go-live with `npm run import:staff`.
model HeadSupervisor {
  civilId String @id
  name    String
}

/// Superusers: may open all three portals (farmer, investigator, head investigator) and see everything.
/// Managed only from the command line with `npm run superuser`; there is no screen for it.
model Superuser {
  civilId String @id
  name    String
}

/// Outside systems allowed to call the declaration API (/api/v1). Managed only from the command line with
/// `npm run api:clients`. Only a SHA-256 hash of the key is stored; the key itself is shown once, when it is created.
model ApiClient {
  id         Int       @id @default(autoincrement())
  name       String    @unique
  keyHash    String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
}

/// Proof that a farmer accepted the legal terms: which version and exact text, when, and through which channel.
/// Written by the declaration API. No foreign key: the record outlives the declaration it was given for.
model LegalAcceptance {
  id         Int      @id @default(autoincrement())
  civilId    String
  version    String
  textHash   String
  acceptedAt DateTime @default(now())
  /// The API client that submitted it.
  source     String

  @@index([civilId])
}

/// One sign-in through PACI. The browser only ever sees `id` (a random token); `paciRequestId` is the
/// identifier PACI echoes back on the callback and never leaves the server.
model LoginAttempt {
  id            String      @id
  civilId       String
  paciRequestId String?     @unique
  status        LoginStatus @default(PENDING)
  detail        String?
  consumed      Boolean     @default(false)
  createdAt     DateTime    @default(now())
  expiresAt     DateTime

  @@index([civilId, createdAt])
}

enum LoginStatus {
  PENDING  // waiting for the person to answer in the PACI app
  APPROVED // PACI confirmed the request
  REFUSED  // the person (or PACI) declined it
  EXPIRED  // no answer in time
  FAILED   // PACI could not be reached or rejected the request outright
}

/// Small key/value store for secrets generated by the app itself (the session signing key).
model AppSecret {
  key   String @id
  value String
}

model Assignment {
  id                Int            @id @default(autoincrement())
  supervisorId      Int
  animalType        AnimalType
  gatheringPoint    GatheringPoint
  groupType         GroupType
  soloDeclarationId Int?
  groupKey          String         @unique
  scheduledDate     DateTime?
  createdAt         DateTime       @default(now())

  supervisor      Supervisor   @relation(fields: [supervisorId], references: [id], onDelete: Cascade)
  soloDeclaration Declaration? @relation("SoloAssignment", fields: [soloDeclarationId], references: [id], onDelete: Cascade)

  @@index([supervisorId])
  @@index([animalType, gatheringPoint])
}

enum DifferenceReason {
  NOT_CHIPPED
  UNREADABLE
  MULTIPLE_CHIPS
  UNREGISTERED_TRADE
  SLAUGHTER_DEATH
  OTHER
}
